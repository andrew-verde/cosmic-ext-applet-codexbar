[Desktop Entry]
Name=CodexBar
Comment=Codex and Claude Code usage limits in the COSMIC panel
Type=Application
Exec=codexbar-cosmic-applet
Terminal=false
Categories=Cosmic;Iced;
Keywords=Cosmic;Iced;Codex;Claude;Usage;
Icon=io.github.andrew-verde.CodexBarCosmicApplet-symbolic
StartupNotify=true
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
